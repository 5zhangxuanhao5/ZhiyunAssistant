{
  "name": "zhiyun-assistant-mac",
  "version": "1.8.2",
  "private": true,
  "description": "Native macOS shell with shared HarmonyOS classroom models",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "verify": "node --experimental-vm-modules generate-models.cjs",
    "test": "node --experimental-vm-modules --test tests/*.test.cjs",
    "sync:harmony": "node sync-harmony-models.cjs",
    "build": "./build.sh",
    "test:native": "./tests/native-contract.sh",
    "test:webkit": "./tests/webkit-smoke.sh",
    "capture:themes": "./tests/theme-gallery.sh"
  },
  "devDependencies": {
    "jsdom": "26.1.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
